# Postgres. На Railway: в сервисе приложения Variables → DATABASE_URL = ${{Postgres.DATABASE_URL}}.
# Без переменной данные живут в памяти процесса (удобно локально, сбрасываются при перезапуске).
DATABASE_URL=

# Ключ для сброса демо к засеву ($210, 14 семей): POST /api/demo/reset с заголовком x-demo-key.
# Без ключа сброс выключен.
DEMO_ADMIN_KEY=
